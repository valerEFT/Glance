datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String
  password String
  cart Cart?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Category {
  id Int @id @default(autoincrement())
  title String
  slug String @unique
  image String

  productItems ProductItem[]

   @@map("category")

}


model ProductItem {
  id    Int     @id @default(autoincrement())
  image String
  title String
  price Int

  category Category @relation(fields: [categoryId], references: [id])
  categoryId Int 
  smartphoneSpecification SmartphoneSpecification?

  @@map("product_item")
}

model SmartphoneSpecification {
  id    Int     @id @default(autoincrement())
  OS String
  model Int
  screenSize String
  numberOfcores Int
  powerSupplyPower Int
  processor String
  RAM Int
  ROM Int
  weight Int

  smartphone ProductItem @relation(fields: [smartphoneId], references: [id])
  smartphoneId Int @unique

  @@map("smartphone_specification")
}

model Cart {
  id    Int     @id @default(autoincrement())

  user User? @relation(fields: [userId], references: [id])
  userId Int? @unique

  cartItem CartItem[]

  @@map("cart")
} 

model CartItem {
  id    Int     @id @default(autoincrement())
  image String
  title String
  price String
  quantity Int

  cart Cart? @relation(fields: [cartId], references: [id])
  cartId Int? @unique

  @@map("cart_item")
}