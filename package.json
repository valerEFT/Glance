{
  "name": "glance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "build:dev": "dotenv -e .env next build",
    "prisma:dev-generate": "dotenv -e .env -- npx prisma generate",
    "prisma:prod-generate": "dotenv -e .env.production -- npx prisma generate",
    "prisma:migrate": "dotenv -e .env -- npx prisma migrate dev",
    "prisma:migrate-deploy": "dotenv -e .env.production -- npx prisma studio",
    "prisma:dev-studio": "dotenv -e .env -- npx prisma studio",
    "prisma:prod-studio": "dotenv -e .env.production -- npx prisma studio",
    "prisma:dev-seed": "ts-node --project tsconfig.prisma.json src/app/prisma/seed.ts",
    "prisma:prod-seed": "dotenv -e .env.production -- npx prisma db seed",
    "prisma:push": "npx prisma db push --force-reset"
  },
  "prisma": {
    "schema": "src/app/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "clsx": "^2.1.1",
    "next": "^15.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^10.0.0",
    "postcss": "^8.5.6",
    "prisma": "^6.12.0",
    "sass": "^1.89.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
